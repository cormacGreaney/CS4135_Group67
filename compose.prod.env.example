# Rename to .env next to docker-compose.prod.yml, then edit values.

# Must match lowercase GitHub owner / org used in GHCR image paths (see CD workflow).
GHCR_PREFIX=ghcr.io/your-github-username-lowercase

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
MYSQL_ROOT_PASSWORD=change-me-mysql

RABBITMQ_USER=app
RABBITMQ_PASS=change-me-rabbit

JWT_SECRET=change-me-use-long-random-string
INTERNAL_API_TOKEN=change-me-internal-token

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
